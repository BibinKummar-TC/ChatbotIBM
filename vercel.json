{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask",
      "bindings": [
        {
          "type": "service",
          "service": "thinkai-studio",
          "format": "url",
          "env": "THINKAI_STUDIO_URL"
        }
      ]
    },
    "thinkai-studio": {
      "root": "thinkai-studio",
      "framework": "flask"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}

# ThinkAI Studio Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or service account credentials to source control.

# Option 1: Google Gemini API Key (Recommended for Google AI Studio)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Google Cloud Service Account (for Google Cloud / Vertex AI)
# Set the local path to your service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# Optional: Set to true to run live API tests with your configured key
RUN_LIVE_API_TESTS=false
